# Copy to /etc/evade-proxy.env (chmod 600). systemd loads this file.
# The probe server refuses to start if PROBE_TOKEN is empty.

PROBE_TOKEN=change-me
PROBE_DOMAINS=/opt/xdp-dns-evadeproxy/probe/domains.json
PROBE_BIND=127.0.0.1
PROBE_PORT=8090
PROBE_RESOLVER_IP=127.0.0.1
PROBE_RESOLVER_PORT=5336

XDP_PREFIX=/opt/xdp-dns-evadeproxy
BLOCKLIST_URL=https://hayahora.futbol/estado/blocked-any.txt

EVADE_BLOCKED_IPV4_FILE=/etc/unbound/blocked_ips.txt
EVADE_BLOCKED_IPV6_FILE=/etc/unbound/blocked_ipv6.txt
EVADE_CF_IPV4_FILE=/etc/unbound/cloudflare_prefixes_v4.txt
EVADE_CF_IPV6_FILE=/etc/unbound/cloudflare_prefixes_v6.txt
EVADE_STATS_FILE=/var/lib/evade-proxy/evade_stats.json
EVADE_REDIRECTS_FILE=/run/evade-proxy/redirects.txt
