[Unit]
Description=XDP probe ingest server (residential block detection)
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/evade-proxy.env
Environment=XDP_PREFIX=/opt/xdp-dns-evadeproxy
ExecStart=/usr/bin/python3 /opt/xdp-dns-evadeproxy/probe/probe-server.py
Restart=always
RestartSec=3s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# Writes probe blocklists and evade-proxy temporary redirects.
ReadWritePaths=/etc/unbound /run/evade-proxy
PrivateTmp=true
# /etc/unbound belongs to the unbound user: creating files there needs
# CAP_DAC_OVERRIDE. Nothing else. dig needs AF_NETLINK.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryMax=256M
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
